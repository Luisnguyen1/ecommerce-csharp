@page "/Checkout"
@model IndexModel
@{
    ViewData["Title"] = "Checkout";
}
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Checkout</h1>
        <p class="mt-1 text-sm text-muted-foreground">Where should we send your order?</p>
    </div>

    <form method="post" novalidate>
        <div class="grid items-start gap-8 lg:grid-cols-[1fr_380px]">
            <div class="space-y-8">
                <!-- Shipping address -->
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title flex items-center gap-2"><icon name="map-pin" class="size-4" /> Shipping address</h2>
                        <p class="card-description">We'll only use this to deliver your order.</p>
                    </div>
                    <div class="card-content">
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="form-field sm:col-span-2">
                                <label class="label" for="Input_FullName">Full name</label>
                                <input asp-for="Input.FullName" class="input" autocomplete="name" placeholder="Ada Lovelace" required />
                                <span asp-validation-for="Input.FullName" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_Email">Email</label>
                                <input asp-for="Input.Email" type="email" class="input" autocomplete="email" placeholder="you@example.com" required />
                                <span asp-validation-for="Input.Email" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_Phone">Phone</label>
                                <input asp-for="Input.Phone" type="tel" class="input" autocomplete="tel" placeholder="+1 555 010 1234" required />
                                <span asp-validation-for="Input.Phone" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field sm:col-span-2">
                                <label class="label" for="Input_Line1">Address line 1</label>
                                <input asp-for="Input.Line1" class="input" autocomplete="address-line1" placeholder="123 Market Street" required />
                                <span asp-validation-for="Input.Line1" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field sm:col-span-2">
                                <label class="label" for="Input_Line2">Address line 2 <span class="font-normal text-muted-foreground">(optional)</span></label>
                                <input asp-for="Input.Line2" class="input" autocomplete="address-line2" placeholder="Apartment, suite, unit…" />
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_City">City</label>
                                <input asp-for="Input.City" class="input" autocomplete="address-level2" placeholder="San Francisco" required />
                                <span asp-validation-for="Input.City" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_State">State</label>
                                <input asp-for="Input.State" class="input" autocomplete="address-level1" placeholder="CA" required />
                                <span asp-validation-for="Input.State" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_PostalCode">Postal code</label>
                                <input asp-for="Input.PostalCode" class="input" autocomplete="postal-code" placeholder="94103" required />
                                <span asp-validation-for="Input.PostalCode" class="text-xs text-destructive"></span>
                            </div>
                            <div class="form-field">
                                <label class="label" for="Input_Country">Country</label>
                                <input asp-for="Input.Country" class="input" autocomplete="country-name" required />
                                <span asp-validation-for="Input.Country" class="text-xs text-destructive"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping method -->
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title flex items-center gap-2"><icon name="truck" class="size-4" /> Shipping method</h2>
                        <p class="card-description">Standard shipping is free on orders over @Shipping.FreeShippingThreshold.Money().</p>
                    </div>
                    <div class="card-content">
                        <div class="grid gap-3">
                            @foreach (var option in Model.ShippingOptions)
                            {
                                <label class="flex cursor-pointer items-center gap-4 rounded-xl border p-4 transition-colors has-[:checked]:border-primary has-[:checked]:bg-accent/50">
                                    <input type="radio" name="ShippingMethodId" value="@option.Id" class="sr-only"
                                           checked="@(Model.ShippingMethodId == option.Id)" />
                                    <icon name="truck" class="size-5 shrink-0 text-muted-foreground" />
                                    <span class="min-w-0 flex-1">
                                        <span class="flex flex-wrap items-center gap-2">
                                            <span class="text-sm font-medium">@option.Name</span>
                                            @if (option.Fee == 0)
                                            {
                                                <span class="badge badge-success">Free</span>
                                            }
                                        </span>
                                        <span class="block text-xs text-muted-foreground">@option.Description</span>
                                    </span>
                                    <span class="shrink-0 text-sm font-semibold tabular-nums @(option.Fee == 0 ? "text-success" : null)">
                                        @(option.Fee == 0 ? "Free" : option.Fee.Money())
                                    </span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="ShippingMethodId" class="text-xs text-destructive"></span>
                    </div>
                </div>
            </div>

            <!-- Order summary -->
            <div class="card lg:sticky lg:top-24">
                <div class="px-6">
                    <h2 class="font-semibold">Order summary</h2>
                </div>
                <ul class="space-y-3 px-6">
                    @foreach (var line in Model.Cart.Lines)
                    {
                        <li class="flex items-center gap-3">
                            <img src="@line.ImageUrl" alt="@line.ProductName" class="size-12 shrink-0 rounded-md border object-cover" loading="lazy" />
                            <div class="min-w-0 flex-1">
                                <a asp-page="/Product/Details" asp-route-slug="@line.ProductSlug" class="line-clamp-1 text-sm font-medium hover:underline">@line.ProductName</a>
                                <p class="text-xs text-muted-foreground">@line.VariantName · Qty @line.Quantity</p>
                            </div>
                            <span class="shrink-0 text-sm font-medium tabular-nums">@line.LineTotal.Money()</span>
                        </li>
                    }
                </ul>
                <div class="space-y-2 px-6 text-sm">
                    <div class="separator"></div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="font-medium tabular-nums">@Model.Totals.Subtotal.Money()</span>
                    </div>
                    @if (Model.Totals.Discount > 0)
                    {
                        <div class="flex items-center justify-between text-success">
                            <span class="inline-flex items-center gap-1">
                                <icon name="tag" class="size-3.5" /> Discount
                            </span>
                            <span class="font-medium tabular-nums">−@Model.Totals.Discount.Money()</span>
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="text-muted-foreground">Added in the next step</span>
                    </div>
                    <div class="flex items-center justify-between border-t pt-3 text-base font-bold">
                        <span>Total</span>
                        <span class="tabular-nums">@Model.Totals.TaxableBase.Money()</span>
                    </div>
                </div>
                <div class="px-6">
                    <button type="submit" class="btn btn-primary btn-lg w-full">
                        Continue to payment <icon name="arrow-right" class="size-4" />
                    </button>
                    <p class="mt-3 text-center text-xs text-muted-foreground">
                        <icon name="lock" class="mr-1 inline size-3" />
                        You'll enter payment details on the next step.
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>
