@page "/Cart"
@model IndexModel
@{
    ViewData["Title"] = "Your cart";
    var remaining = Shipping.FreeShippingThreshold - Model.Totals.Subtotal;
    var progress = (int)Math.Clamp(Model.Totals.Subtotal / Shipping.FreeShippingThreshold * 100, 0, 100);
}
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Your cart</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            @(Model.Cart.ItemCount == 1 ? "1 item" : $"{Model.Cart.ItemCount} items")
        </p>
    </div>

    @if (Model.Cart.IsEmpty)
    {
        <div class="card mx-auto max-w-lg items-center py-16 text-center">
            <div class="flex size-16 items-center justify-center rounded-full bg-muted text-muted-foreground">
                <icon name="shopping-cart" class="size-8" />
            </div>
            <div class="space-y-1">
                <h2 class="text-lg font-semibold">Your cart is empty</h2>
                <p class="text-sm text-muted-foreground">Looks like you haven't added anything yet — let's fix that.</p>
            </div>
            <a asp-page="/Catalog/Index" class="btn btn-primary btn-lg">
                <icon name="shopping-bag" class="size-4" /> Browse the shop
            </a>
        </div>
    }
    else
    {
        <div class="grid items-start gap-8 lg:grid-cols-[1fr_380px]">
            <!-- Line items -->
            <div class="card">
                <ul class="divide-y">
                    @foreach (var line in Model.Cart.Lines)
                    {
                        <li class="flex gap-4 p-4 sm:p-6">
                            <a asp-page="/Product/Details" asp-route-slug="@line.ProductSlug" class="shrink-0" tabindex="-1" aria-hidden="true">
                                <img src="@line.ImageUrl" alt="@line.ProductName" class="size-20 rounded-lg border object-cover" loading="lazy" />
                            </a>

                            <div class="flex min-w-0 flex-1 flex-col gap-1">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <a asp-page="/Product/Details" asp-route-slug="@line.ProductSlug" class="line-clamp-2 font-medium leading-snug hover:underline">
                                            @line.ProductName
                                        </a>
                                        <p class="text-sm text-muted-foreground">@line.VariantName</p>
                                        <p class="text-sm text-muted-foreground">@line.UnitPrice.Money() each</p>
                                        @if (line.StockAvailable < line.Quantity)
                                        {
                                            <p class="mt-1 flex items-center gap-1 text-xs font-medium text-destructive">
                                                <icon name="alert-circle" class="size-3.5" />
                                                Only @line.StockAvailable left in stock — please reduce the quantity
                                            </p>
                                        }
                                    </div>
                                    <p class="shrink-0 font-semibold tabular-nums">@line.LineTotal.Money()</p>
                                </div>

                                <div class="mt-auto flex items-center justify-between gap-2 pt-2">
                                    <!-- Quantity: one mini-form per action -->
                                    <div class="flex items-center gap-1" aria-label="Quantity">
                                        <form asp-page="/Cart/Index" asp-page-handler="SetQuantity" method="post">
                                            <input type="hidden" name="productId" value="@line.ProductId" />
                                            <input type="hidden" name="variantId" value="@line.VariantId" />
                                            <input type="hidden" name="quantity" value="@(line.Quantity - 1)" />
                                            <button type="submit" class="flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-accent hover:text-accent-foreground"
                                                    aria-label="Decrease quantity" title="Decrease quantity">
                                                <icon name="minus" class="size-3.5" />
                                            </button>
                                        </form>
                                        <span class="w-8 text-center text-sm font-semibold tabular-nums">@line.Quantity</span>
                                        <form asp-page="/Cart/Index" asp-page-handler="SetQuantity" method="post">
                                            <input type="hidden" name="productId" value="@line.ProductId" />
                                            <input type="hidden" name="variantId" value="@line.VariantId" />
                                            <input type="hidden" name="quantity" value="@(line.Quantity + 1)" />
                                            <button type="submit" class="flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-50"
                                                    aria-label="Increase quantity" title="Increase quantity" @(line.Quantity >= line.StockAvailable ? "disabled" : null)>
                                                <icon name="plus" class="size-3.5" />
                                            </button>
                                        </form>
                                    </div>

                                    <form asp-page="/Cart/Index" asp-page-handler="Remove" method="post">
                                        <input type="hidden" name="productId" value="@line.ProductId" />
                                        <input type="hidden" name="variantId" value="@line.VariantId" />
                                        <button type="submit" class="flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-destructive"
                                                aria-label="Remove item" title="Remove item">
                                            <icon name="trash-2" class="size-4" />
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <!-- Order summary -->
            <div class="card lg:sticky lg:top-24">
                <div class="px-6">
                    <h2 class="font-semibold">Order summary</h2>
                </div>

                <div class="space-y-3 px-6 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="font-medium tabular-nums">@Model.Totals.Subtotal.Money()</span>
                    </div>
                    @if (Model.Totals.Discount > 0)
                    {
                        <div class="flex items-center justify-between text-success">
                            <span class="inline-flex items-center gap-1">
                                <icon name="tag" class="size-3.5" /> Discount
                            </span>
                            <span class="font-medium tabular-nums">−@Model.Totals.Discount.Money()</span>
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="text-muted-foreground">Calculated at checkout</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Totals.CouponError))
                    {
                        <div class="alert alert-destructive">
                            <icon name="alert-circle" />
                            <div>
                                <p class="alert-title">Coupon issue</p>
                                <div class="alert-description">
                                    <p>@Model.Totals.CouponError</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Coupon -->
                    @if (!string.IsNullOrEmpty(Model.Cart.AppliedCouponCode))
                    {
                        <div class="flex items-center justify-between gap-2 rounded-lg border border-dashed bg-muted/40 px-3 py-2">
                            <span class="inline-flex items-center gap-2 text-sm">
                                <icon name="tag" class="size-4 text-success" />
                                <span class="font-mono font-semibold uppercase">@Model.Cart.AppliedCouponCode</span>
                            </span>
                            <form asp-page="/Cart/Index" asp-page-handler="RemoveCoupon" method="post">
                                <button type="submit" class="flex size-6 items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-destructive"
                                        aria-label="Remove coupon" title="Remove coupon">
                                    <icon name="x" class="size-3.5" />
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form asp-page="/Cart/Index" asp-page-handler="ApplyCoupon" method="post" class="flex gap-2">
                            <input type="text" name="code" placeholder="Promo code" maxlength="24"
                                   class="input h-9 font-mono uppercase" autocomplete="off" required />
                            <button type="submit" class="btn btn-outline shrink-0">Apply</button>
                        </form>
                    }

                    <!-- Free shipping progress -->
                    @if (remaining > 0)
                    {
                        <div class="space-y-2">
                            <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <icon name="truck" class="size-3.5" />
                                Add <span class="font-semibold text-foreground">@remaining.Money()</span> more for free shipping
                            </p>
                            <div class="h-2 rounded-full bg-muted" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" aria-label="Free shipping progress">
                                <div class="h-2 rounded-full bg-primary transition-all" style="width:@(progress)%"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="flex items-center gap-1.5 text-xs font-medium text-success">
                            <icon name="check-circle" class="size-3.5" />
                            You've unlocked free standard shipping!
                        </p>
                    }
                </div>

                <div class="space-y-3 px-6">
                    <a asp-page="/Checkout/Index" class="btn btn-primary btn-lg w-full">
                        Proceed to checkout <icon name="arrow-right" class="size-4" />
                    </a>
                    <a asp-page="/Catalog/Index" class="btn btn-ghost w-full">Continue shopping</a>
                    <form asp-page="/Cart/Index" asp-page-handler="Clear" method="post" data-confirm="Remove all items from your cart?">
                        <button type="submit" class="inline-flex items-center gap-1 text-xs text-muted-foreground underline-offset-4 transition-colors hover:text-destructive hover:underline">
                            <icon name="trash-2" class="size-3.5" /> Clear cart
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
