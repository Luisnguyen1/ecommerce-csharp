@page "/Account/Wishlist"
@model WishlistModel
@{
    ViewData["Title"] = "Wishlist";
}
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Wishlist</h1>
        <p class="mt-1 text-sm text-muted-foreground">Products you've saved for later.</p>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="card mx-auto max-w-lg items-center py-16 text-center">
            <div class="flex size-16 items-center justify-center rounded-full bg-muted text-muted-foreground">
                <icon name="heart" class="size-8" />
            </div>
            <div class="space-y-1">
                <h2 class="text-lg font-semibold">Your wishlist is empty</h2>
                <p class="text-sm text-muted-foreground">Tap the heart on any product to save it here.</p>
            </div>
            <a asp-page="/Catalog/Index" class="btn btn-primary btn-lg">
                <icon name="search" class="size-4" /> Find something you love
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</div>
