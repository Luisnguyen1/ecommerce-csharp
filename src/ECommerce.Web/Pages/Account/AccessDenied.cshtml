@page "/Account/AccessDenied"
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="card mx-auto max-w-md items-center py-12 text-center">
        <div class="flex size-16 items-center justify-center rounded-full bg-muted text-muted-foreground">
            <icon name="lock" class="size-8" />
        </div>
        <div class="space-y-1">
            <h1 class="text-2xl font-bold tracking-tight">Access denied</h1>
            <p class="text-sm text-muted-foreground">You need admin access for that area.</p>
        </div>
        <div class="flex flex-col gap-3">
            <a asp-page="/Index" class="btn btn-primary btn-lg">Back to home</a>
            <a asp-page="/Account/Login" class="btn btn-ghost">Sign in as a different user</a>
        </div>
    </div>
</div>
