@page "{id}"
@model DetailsModel
@{
    ViewData["Title"] = $"Order {Model.Order!.OrderNumber}";
    var order = Model.Order;
}
<div class="mb-6">
    <a asp-page="./Index" class="btn btn-ghost btn-sm mb-3"><icon name="chevron-left" class="size-4" /> All orders</a>
    <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-mono text-2xl font-bold tracking-tight">@order.OrderNumber</h1>
        <partial name="_StatusBadge" model="order.Status" />
        <div class="ml-auto text-right text-sm text-muted-foreground">
            <p>Placed @order.PlacedAt.Friendly()</p>
            @if (order.UpdatedAt is { } updated)
            {
                <p>Updated @updated.Friendly()</p>
            }
        </div>
    </div>
</div>

<!-- Actions -->
<section class="card mb-6">
    <div class="card-header">
        <h2 class="card-title">Actions</h2>
        <p class="card-description">Move the order through the fulfilment pipeline.</p>
    </div>
    <div class="card-content flex flex-wrap items-center gap-2">
        @switch (order.Status)
        {
            case OrderStatus.Placed:
                <p class="mr-2 flex items-center gap-2 text-sm text-muted-foreground">
                    <icon name="clock" class="size-4" /> Awaiting payment.
                </p>
                <form method="post" asp-page-handler="Advance" asp-route-id="@order.Id" data-confirm="Cancel this order? Stock will be restored and the customer emailed.">
                    <input type="hidden" name="to" value="@OrderStatus.Cancelled" />
                    <button type="submit" class="btn btn-destructive">
                        <icon name="x" class="size-4" /> Cancel order
                    </button>
                </form>
                break;
            case OrderStatus.Paid:
                <form method="post" asp-page-handler="Advance" asp-route-id="@order.Id">
                    <input type="hidden" name="to" value="@OrderStatus.Shipped" />
                    <button type="submit" class="btn btn-primary">
                        <icon name="truck" class="size-4" /> Mark as shipped
                    </button>
                </form>
                <form method="post" asp-page-handler="Advance" asp-route-id="@order.Id" data-confirm="Cancel this order? Stock will be restored and the customer emailed.">
                    <input type="hidden" name="to" value="@OrderStatus.Cancelled" />
                    <button type="submit" class="btn btn-destructive">
                        <icon name="x" class="size-4" /> Cancel order
                    </button>
                </form>
                break;
            case OrderStatus.Shipped:
                <form method="post" asp-page-handler="Advance" asp-route-id="@order.Id">
                    <input type="hidden" name="to" value="@OrderStatus.Delivered" />
                    <button type="submit" class="btn btn-success">
                        <icon name="check" class="size-4" /> Mark as delivered
                    </button>
                </form>
                break;
            default:
                <p class="flex items-center gap-2 text-sm text-muted-foreground">
                    <icon name="check-circle" class="size-4 text-success" />
                    This order is @order.Status.ToString().ToLowerInvariant() — no further actions.
                </p>
                break;
        }
    </div>
</section>

<div class="grid items-start gap-6 lg:grid-cols-3">
    <!-- Items -->
    <section class="card lg:col-span-2">
        <div class="card-header">
            <h2 class="card-title">Items (@order.Lines.Sum(l => l.Quantity))</h2>
            <p class="card-description">Immutable snapshots taken at checkout.</p>
        </div>
        <div class="card-content overflow-x-auto">
            <table class="table-shad">
                <thead>
                    <tr>
                        <th class="w-14"></th>
                        <th>Item</th>
                        <th class="text-right">Unit</th>
                        <th class="text-right">Qty</th>
                        <th class="text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in order.Lines)
                    {
                        <tr>
                            <td>
                                @if (string.IsNullOrEmpty(line.ImageUrl))
                                {
                                    <span class="flex size-14 items-center justify-center rounded-lg bg-muted text-muted-foreground">
                                        <icon name="image" class="size-4" />
                                    </span>
                                }
                                else
                                {
                                    <img src="@line.ImageUrl" alt="" class="size-14 rounded-lg border object-cover" loading="lazy" />
                                }
                            </td>
                            <td>
                                <div class="flex flex-col">
                                    <span class="font-medium">@line.ProductName</span>
                                    @if (!string.IsNullOrEmpty(line.VariantName))
                                    {
                                        <span class="text-xs text-muted-foreground">@line.VariantName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(line.Sku))
                                    {
                                        <span class="font-mono text-xs text-muted-foreground">@line.Sku</span>
                                    }
                                </div>
                            </td>
                            <td class="whitespace-nowrap text-right">@line.UnitPrice.Money()</td>
                            <td class="text-right text-muted-foreground">@line.Quantity</td>
                            <td class="whitespace-nowrap text-right font-semibold">@line.LineTotal.Money()</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="mt-4 flex items-center justify-end gap-6 border-t pt-4">
                <span class="text-sm text-muted-foreground">Total</span>
                <span class="text-lg font-bold">@order.Total.Money()</span>
            </div>
        </div>
    </section>

    <!-- Side column -->
    <div class="space-y-6">
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Customer</h2>
            </div>
            <div class="card-content space-y-3 text-sm">
                <div class="flex items-center gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <icon name="user" class="size-4" />
                    </span>
                    <div class="min-w-0">
                        <p class="font-medium">@(string.IsNullOrWhiteSpace(order.ShippingAddress.FullName) ? "Guest" : order.ShippingAddress.FullName)</p>
                        <p class="truncate text-muted-foreground" title="@order.Email">@order.Email</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(order.ShippingAddress.Phone))
                {
                    <p class="text-muted-foreground">@order.ShippingAddress.Phone</p>
                }
                <div class="separator"></div>
                <div class="flex gap-2.5">
                    <icon name="map-pin" class="size-4 shrink-0 translate-y-0.5 text-muted-foreground" />
                    <div>
                        <p>@order.ShippingAddress.Line1</p>
                        @if (!string.IsNullOrWhiteSpace(order.ShippingAddress.Line2))
                        {
                            <p>@order.ShippingAddress.Line2</p>
                        }
                        <p>@order.ShippingAddress.City, @order.ShippingAddress.State @order.ShippingAddress.PostalCode</p>
                        <p class="text-muted-foreground">@order.ShippingAddress.Country</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Payment &amp; shipping</h2>
            </div>
            <div class="card-content space-y-3 text-sm">
                <div class="flex items-center gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <icon name="credit-card" class="size-4" />
                    </span>
                    <div>
                        <p class="font-medium">@(string.IsNullOrEmpty(order.CardLast4) ? "No card recorded" : $"•••• {order.CardLast4}")</p>
                        <p class="text-xs text-muted-foreground">Mock gateway</p>
                    </div>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Transaction</p>
                    <p class="break-all font-mono text-xs">@(string.IsNullOrEmpty(order.PaymentTransactionId) ? "—" : order.PaymentTransactionId)</p>
                </div>
                <div class="separator"></div>
                <div class="flex items-center gap-2.5">
                    <icon name="truck" class="size-4 shrink-0 text-muted-foreground" />
                    <span>@(string.IsNullOrEmpty(order.ShippingMethodName) ? "Standard shipping" : order.ShippingMethodName)</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Totals</h2>
            </div>
            <div class="card-content space-y-2 text-sm">
                <div class="flex justify-between">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span>@order.Subtotal.Money()</span>
                </div>
                @if (order.Discount > 0)
                {
                    <div class="flex justify-between text-success">
                        <span class="flex items-center gap-1.5">
                            <icon name="tag" class="size-3.5" />
                            @(string.IsNullOrEmpty(order.CouponCode) ? "Discount" : $"Discount ({order.CouponCode})")
                        </span>
                        <span>−@order.Discount.Money()</span>
                    </div>
                }
                <div class="flex justify-between">
                    <span class="text-muted-foreground">Shipping</span>
                    <span>@order.ShippingFee.Money()</span>
                </div>
                <div class="separator"></div>
                <div class="flex justify-between text-base font-bold">
                    <span>Total</span>
                    <span>@order.Total.Money()</span>
                </div>
            </div>
        </section>
    </div>
</div>
