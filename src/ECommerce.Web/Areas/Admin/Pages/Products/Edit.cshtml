@page "{id}"
@model EditModel
@{
    ViewData["Title"] = $"Edit — {Model.ProductName}";
}
<div class="mb-6 flex flex-wrap items-center gap-3">
    <a asp-page="./Index" class="btn btn-ghost btn-sm"><icon name="chevron-left" class="size-4" /> Products</a>
    <div class="min-w-0">
        <h1 class="truncate text-2xl font-bold tracking-tight" title="@Model.ProductName">Edit — @Model.ProductName</h1>
        <p class="text-sm text-muted-foreground">Update the catalog entry.</p>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="grid items-start gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        <!-- Details -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Product details</h2>
                <p class="card-description">Core catalog information shown to shoppers.</p>
            </div>
            <div class="card-content grid gap-4">
                <div class="form-field">
                    <label class="label" asp-for="Input.Name">Name</label>
                    <input asp-for="Input.Name" class="input" autocomplete="off" />
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="form-field">
                        <label class="label" asp-for="Input.Slug">Slug</label>
                        <input asp-for="Input.Slug" class="input font-mono" autocomplete="off" />
                        <p class="text-xs text-muted-foreground">Used in the product URL — must stay unique.</p>
                    </div>
                    <div class="form-field">
                        <label class="label" asp-for="Input.Brand">Brand</label>
                        <input asp-for="Input.Brand" class="input" autocomplete="off" />
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="form-field">
                        <label class="label" asp-for="Input.CategoryId">Category</label>
                        <select asp-for="Input.CategoryId" class="select">
                            <option value="">Select a category…</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@(category.IsActive ? category.Name : $"{category.Name} (inactive)")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="label" asp-for="Input.Badge">Badge</label>
                        <input asp-for="Input.Badge" list="badge-options" class="input" autocomplete="off" />
                        <datalist id="badge-options">
                            <option value="New"></option>
                            <option value="Sale"></option>
                            <option value="Hot"></option>
                        </datalist>
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="form-field">
                        <label class="label" asp-for="Input.Price">Price (USD)</label>
                        <input asp-for="Input.Price" type="number" step="0.01" min="0" class="input" />
                    </div>
                    <div class="form-field">
                        <label class="label" asp-for="Input.CompareAtPrice">Compare-at price</label>
                        <input asp-for="Input.CompareAtPrice" type="number" step="0.01" min="0" class="input" placeholder="Optional — shown struck through" />
                    </div>
                </div>
                <div class="flex flex-wrap gap-x-8 gap-y-3 pt-1">
                    <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
                        <input asp-for="Input.IsFeatured" class="size-4 accent-primary" />
                        <icon name="star" class="size-4 text-muted-foreground" /> Featured on home page
                    </label>
                    <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
                        <input asp-for="Input.IsActive" class="size-4 accent-primary" />
                        Visible in store
                    </label>
                </div>
                <div class="form-field">
                    <label class="label" asp-for="Input.Description">Description</label>
                    <textarea asp-for="Input.Description" class="textarea" rows="6"></textarea>
                </div>
            </div>
        </section>

        <!-- Images -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Images</h2>
                <p class="card-description">The first image is used as the card thumbnail. Check "Remove" to delete an image on save.</p>
            </div>
            <div class="card-content grid gap-4">
                @if (Model.Images.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No images yet — upload some below.</p>
                }
                else
                {
                    <div class="flex flex-wrap gap-4">
                        @foreach (var image in Model.Images)
                        {
                            <label class="flex cursor-pointer flex-col items-center gap-1.5">
                                <img src="@image" alt="" class="size-20 rounded-lg border object-cover" loading="lazy" />
                                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <input type="checkbox" name="Input.RemoveImages" value="@image" class="size-3.5 accent-destructive" />
                                    Remove
                                </span>
                            </label>
                        }
                    </div>
                }
                <div class="form-field">
                    <label class="label" for="Input_NewImages">Upload more images</label>
                    <input asp-for="Input.NewImages" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.gif,.svg"
                           class="input cursor-pointer py-1.5 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-secondary file:px-3 file:py-1 file:text-sm file:font-medium file:text-secondary-foreground" />
                    <p class="text-xs text-muted-foreground">SVG, PNG, JPG, WEBP or GIF — up to 2 MB each. New images are appended after existing ones.</p>
                </div>
            </div>
        </section>

        <!-- Variants -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Variants</h2>
                <p class="card-description">Sizes, colors and per-variant stock. Leave empty for a single standard product.</p>
            </div>
            <div class="card-content space-y-3">
                <div class="hidden gap-2 text-xs font-medium text-muted-foreground lg:grid lg:grid-cols-[1fr_1fr_1fr_1fr_100px_100px_auto] lg:items-center">
                    <span>Name</span><span>Color</span><span>Size</span><span>SKU</span><span>Price</span><span>Stock</span><span></span>
                </div>
                <div id="variant-rows" class="space-y-2">
                    @for (var i = 0; i < Model.Input.Variants.Count; i++)
                    {
                        var variant = Model.Input.Variants[i];
                        <div class="variant-row grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-[1fr_1fr_1fr_1fr_100px_100px_auto] lg:items-center">
                            <input type="hidden" data-field="Id" value="@variant.Id" />
                            <input type="text" class="input" data-field="Name" value="@variant.Name" placeholder="Black / L" autocomplete="off" />
                            <input type="text" class="input" data-field="Color" value="@variant.Color" placeholder="Black" autocomplete="off" />
                            <input type="text" class="input" data-field="Size" value="@variant.Size" placeholder="L" autocomplete="off" />
                            <input type="text" class="input" data-field="Sku" value="@variant.Sku" placeholder="NB-001" autocomplete="off" />
                            <input type="number" class="input" data-field="PriceOverride" value="@variant.PriceOverride" step="0.01" min="0" placeholder="Base" title="Price override — leave empty to use the base price" />
                            <input type="number" class="input" data-field="Stock" value="@variant.Stock" min="0" />
                            <button type="button" class="btn btn-ghost btn-icon text-destructive" data-remove-variant aria-label="Remove variant" title="Remove variant">
                                <icon name="x" class="size-4" />
                            </button>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline btn-sm" data-add-variant>
                    <icon name="plus" class="size-4" /> Add variant
                </button>
                <div class="separator"></div>
                <div class="form-field max-w-48 @(Model.Input.Variants.Count > 0 ? "hidden" : "")" id="base-stock-field">
                    <label class="label" asp-for="Input.BaseStock">Base stock</label>
                    <input asp-for="Input.BaseStock" type="number" min="0" class="input" />
                    <p class="text-xs text-muted-foreground">Used when no variant rows exist — one default variant is saved with this stock.</p>
                </div>
            </div>
        </section>

        <template id="variant-row-template">
            <div class="variant-row grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-[1fr_1fr_1fr_1fr_100px_100px_auto] lg:items-center">
                <input type="hidden" data-field="Id" value="" />
                <input type="text" class="input" data-field="Name" placeholder="Black / L" autocomplete="off" />
                <input type="text" class="input" data-field="Color" placeholder="Black" autocomplete="off" />
                <input type="text" class="input" data-field="Size" placeholder="L" autocomplete="off" />
                <input type="text" class="input" data-field="Sku" placeholder="NB-001" autocomplete="off" />
                <input type="number" class="input" data-field="PriceOverride" step="0.01" min="0" placeholder="Base" title="Price override — leave empty to use the base price" />
                <input type="number" class="input" data-field="Stock" min="0" value="0" />
                <button type="button" class="btn btn-ghost btn-icon text-destructive" data-remove-variant aria-label="Remove variant" title="Remove variant">
                    <icon name="x" class="size-4" />
                </button>
            </div>
        </template>
    </div>

    <aside class="lg:sticky lg:top-6">
        <section class="card gap-4">
            <div class="card-header">
                <h2 class="card-title">Save changes</h2>
                <p class="card-description">Changes apply to the live catalog immediately.</p>
            </div>
            <div class="card-footer flex-col items-stretch gap-2">
                <button type="submit" class="btn btn-primary">
                    <icon name="check" class="size-4" /> Save product
                </button>
                <a asp-page="./Index" class="btn btn-ghost">Cancel</a>
            </div>
        </section>
    </aside>
</form>

@section Scripts {
    <script>
        (function () {
            // Variant rows editor: template + re-index so model binding sees a contiguous list.
            var rows = document.getElementById('variant-rows');
            var template = document.getElementById('variant-row-template');
            var baseStock = document.getElementById('base-stock-field');

            function reindex() {
                if (!rows) return;
                rows.querySelectorAll('.variant-row').forEach(function (row, i) {
                    row.querySelectorAll('[data-field]').forEach(function (input) {
                        input.name = 'Input.Variants[' + i + '].' + input.getAttribute('data-field');
                    });
                });
                syncBaseStock();
            }

            function syncBaseStock() {
                if (!baseStock || !rows) return;
                baseStock.classList.toggle('hidden', rows.querySelectorAll('.variant-row').length > 0);
            }

            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-add-variant]')) {
                    if (rows && template) rows.appendChild(template.content.cloneNode(true));
                    reindex();
                    return;
                }
                var remove = e.target.closest('[data-remove-variant]');
                if (remove) {
                    var row = remove.closest('.variant-row');
                    if (row) row.remove();
                    reindex();
                }
            });

            reindex();
        })();
    </script>
}
