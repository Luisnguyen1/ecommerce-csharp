@page
@model IndexModel
@{
    ViewData["Title"] = "Coupons";
}
<div class="mb-6">
    <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
        Coupons
        <span class="badge badge-secondary">@Model.Coupons.Count</span>
    </h1>
    <p class="text-sm text-muted-foreground">Discount codes customers can apply at checkout.</p>
</div>

<!-- Create -->
<section class="card">
    <div class="card-header">
        <h2 class="card-title">New coupon</h2>
        <p class="card-description">Codes are stored uppercase — try it at checkout once saved.</p>
    </div>
    <form method="post" asp-page-handler="Create">
        <div class="card-content grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div class="form-field">
                <label class="label" asp-for="Input.Code">Code</label>
                <input asp-for="Input.Code" class="input font-mono uppercase" placeholder="WELCOME10" autocomplete="off" maxlength="32" />
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.Description">Description</label>
                <input asp-for="Input.Description" class="input" placeholder="10% off your first order" autocomplete="off" />
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.DiscountType">Discount type</label>
                <select asp-for="Input.DiscountType" class="select">
                    <option value="@DiscountType.Percent">Percent (%)</option>
                    <option value="@DiscountType.Fixed">Fixed ($)</option>
                </select>
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.Value">Value</label>
                <input asp-for="Input.Value" type="number" step="0.01" min="0" class="input" placeholder="10" />
                <p class="text-xs text-muted-foreground">Percent (1–100) or a fixed amount.</p>
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.MinOrderAmount">Minimum order</label>
                <input asp-for="Input.MinOrderAmount" type="number" step="0.01" min="0" class="input" placeholder="0.00" />
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.ExpiresAt">Expires at</label>
                <input asp-for="Input.ExpiresAt" type="date" class="input" />
            </div>
            <div class="form-field">
                <label class="label" asp-for="Input.UsageLimit">Usage limit</label>
                <input asp-for="Input.UsageLimit" type="number" min="1" class="input" placeholder="Unlimited" />
                <p class="text-xs text-muted-foreground">Leave empty for no limit.</p>
            </div>
            <div class="form-field">
                <label class="label">Status</label>
                <label class="flex h-9 items-center gap-2 text-sm">
                    <input asp-for="Input.IsActive" class="size-4 accent-primary" />
                    Active
                </label>
            </div>
        </div>
        <div class="card-footer justify-end">
            <button type="submit" class="btn btn-primary">
                <icon name="plus" class="size-4" /> Create coupon
            </button>
        </div>
    </form>
</section>

<!-- List -->
<section class="card mt-6">
    <div class="card-content overflow-x-auto">
        @if (Model.Coupons.Count == 0)
        {
            <div class="flex flex-col items-center gap-2 py-16 text-center text-muted-foreground">
                <icon name="tag" class="size-8" />
                <p class="text-sm">No coupons yet — create the first one above.</p>
            </div>
        }
        else
        {
            <table class="table-shad">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Discount</th>
                        <th class="text-right">Min order</th>
                        <th>Expiry</th>
                        <th>Usage</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model.Coupons)
                    {
                        var discount = coupon.DiscountType == DiscountType.Percent
                            ? $"{coupon.Value:0.##}%"
                            : coupon.Value.Money();
                        var expired = coupon.ExpiresAt is { } expires && expires < DateTime.UtcNow;
                        <tr>
                            <td><span class="font-mono font-semibold">@coupon.Code</span></td>
                            <td class="max-w-56 truncate text-muted-foreground" title="@coupon.Description">@coupon.Description</td>
                            <td class="whitespace-nowrap font-medium">@discount</td>
                            <td class="whitespace-nowrap text-right text-muted-foreground">@(coupon.MinOrderAmount > 0 ? coupon.MinOrderAmount.Money() : "—")</td>
                            <td class="whitespace-nowrap">
                                @if (coupon.ExpiresAt is { } expiry)
                                {
                                    <span class="@(expired ? "text-destructive" : "text-muted-foreground")">@expiry.Friendly()</span>
                                    if (expired)
                                    {
                                        <span class="ml-1 text-xs text-destructive">(expired)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted-foreground">—</span>
                                }
                            </td>
                            <td>
                                <div class="flex flex-col gap-1.5">
                                    <span class="whitespace-nowrap text-sm">@(coupon.UsageLimit is { } limit ? $"{coupon.TimesUsed} / {limit}" : $"{coupon.TimesUsed} / ∞")</span>
                                    @if (coupon.UsageLimit is { } cap && cap > 0)
                                    {
                                        var pct = Math.Min(100, (int)Math.Round(coupon.TimesUsed / (double)cap * 100));
                                        <div class="h-1.5 w-20 overflow-hidden rounded-full bg-muted">
                                            <div class="h-full rounded-full @(pct >= 100 ? "bg-destructive" : "bg-primary")" style="width:@pct%"></div>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (coupon.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-destructive">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@coupon.Id">
                                        <button type="submit" class="btn btn-ghost btn-sm" title="@(coupon.IsActive ? "Deactivate" : "Activate")">
                                            <icon name="eye" class="size-4" />
                                            @(coupon.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@coupon.Id" data-confirm="Delete this coupon? Customers will no longer be able to redeem it.">
                                        <button type="submit" class="btn btn-ghost btn-sm text-destructive" title="Delete">
                                            <icon name="trash-2" class="size-4" />
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
